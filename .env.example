# Copy to .env and fill in. Load it however you like, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or source it from the systemd unit with EnvironmentFile=.

# --- Google Custom Search JSON API ---
# 1. Create a Programmable Search Engine at https://programmablesearchengine.google.com/
#    (set it to "Search the entire web") and copy its Search engine ID -> GOOGLE_CSE_ID.
# 2. Create an API key with the "Custom Search API" enabled at
#    https://console.cloud.google.com/apis/credentials -> GOOGLE_API_KEY.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Fact-check tuning ---
SEARCH_RESULTS=8
MIN_RELEVANT_RESULTS=3
CONFIDENCE_THRESHOLD=0.7

# --- Screen (2.4"-2.5" SPI displays are commonly 240x320) ---
SCREEN_WIDTH=240
SCREEN_HEIGHT=320
DISPLAY_DRIVER=dummy   # dummy | st7789 | ili9341
DISPLAY_SPI_PORT=0
DISPLAY_SPI_DEVICE=0
DISPLAY_GPIO_DC=24
DISPLAY_GPIO_RST=25

# --- Input ---
MIC_DEVICE_INDEX=-1    # -1 = default mic; run `python -m soccerball8.audio` to list devices
BUTTON_GPIO_PIN=17
