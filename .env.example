# Copy to .env and fill in. Load it however you like, e.g.:
#   export $(grep -v '^#' .env | xargs)
# or source it from the systemd unit with EnvironmentFile=.

# --- Google Custom Search JSON API ---
# 1. Create a Programmable Search Engine at https://programmablesearchengine.google.com/
#    (set it to "Search the entire web") and copy its Search engine ID -> GOOGLE_CSE_ID.
# 2. Create an API key with the "Custom Search API" enabled at
#    https://console.cloud.google.com/apis/credentials -> GOOGLE_API_KEY.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Fact-check tuning ---
SEARCH_RESULTS=8
MIN_RELEVANT_RESULTS=3
CONFIDENCE_THRESHOLD=0.7

# --- Screen (2.4"-2.5" SPI displays are commonly 240x320) ---
SCREEN_WIDTH=240
SCREEN_HEIGHT=320
DISPLAY_DRIVER=dummy   # dummy | st7789 | ili9341
DISPLAY_SPI_PORT=0
DISPLAY_SPI_DEVICE=0
DISPLAY_GPIO_DC=24
DISPLAY_GPIO_RST=25

# --- Input ---
MIC_DEVICE_INDEX=-1    # -1 = default mic; run `python -m soccerball8.audio` to list devices

# --- Shake-to-ask trigger (MPU6050 accelerometer over I2C) ---
ACCELEROMETER_BUS=1
ACCELEROMETER_ADDRESS=0x68
SHAKE_THRESHOLD_G=0.8      # how hard a swing has to be (deviation from resting 1g) to count
SHAKE_REQUIRED_SPIKES=3    # how many swings within the window before it counts as "shaken"
SHAKE_WINDOW_SECONDS=1.0
SHAKE_COOLDOWN_SECONDS=1.5 # settle time after a shake is detected, before listening starts

# --- Low-power warning LED ---
# Auto-upgrades to an INA219 voltage sensor for an earlier warning if one is
# wired in and detected on the I2C bus; otherwise falls back automatically
# to the Pi's own under-voltage detection (no INA219 required).
LOW_POWER_LED_GPIO_PIN=27
LOW_POWER_POLL_SECONDS=5.0
INA219_BUS=1
INA219_ADDRESS=0x40
INA219_THRESHOLD_V=4.8   # warn once the 5V rail sags below this (only used if an INA219 is present)
